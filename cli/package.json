{
  "name": "vibeworkflow",
  "version": "0.3.0",
  "description": "Agent-driven workflow for planning, building, checking, and recovering AI-coded projects. Ask your AI coding agent to run npx vibeworkflow. Zero runtime dependencies.",
  "type": "module",
  "keywords": [
    "vibe-coding",
    "agents-md",
    "ai-workflow",
    "prd",
    "tech-design",
    "scaffolding",
    "claude-code",
    "cursor",
    "codex",
    "gemini-cli",
    "prompt-engineering",
    "mvp",
    "ai-agents",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KhazP/vibe-coding-prompt-template.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/KhazP/vibe-coding-prompt-template#readme",
  "bugs": {
    "url": "https://github.com/KhazP/vibe-coding-prompt-template/issues"
  },
  "bin": {
    "vibeworkflow": "./bin/vibeworkflow.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-templates.mjs",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\"",
    "prepack": "npm run build",
    "test:package": "node scripts/package-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
